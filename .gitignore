# Datasets and built databases: ~1.1 GB combined, fully regenerable with
#   python scripts/fetch.py && python scripts/build.py
# Excluded by directory AND by extension, so a stray .db written anywhere
# else cannot be staged by accident.
# leading slash matters: a bare "data/" would also swallow docs/data/,
# which is the site's content and must be committed
/data/
/db/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.csv
*.zip

# Generated report - regenerate with: python scripts/run.py
/docs/RESULTS.md

# Local tool state. Anchored to the repo root: the previous unanchored globs
# matched these directories only by accident, and would also have caught any
# file whose name happened to end the same way, anywhere in the tree.
# DESIGN.md and PRODUCT.md are generated output too - kept locally.
/.claude/
/.agents/
/.impeccable/
/DESIGN.md
/PRODUCT.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
